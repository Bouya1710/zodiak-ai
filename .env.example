# Copiez en .env. Toutes les valeurs ont un défaut raisonnable : le fichier est facultatif.

# --- Mode ---
MODE=personal              # personal (1 utilisateur, sans connexion ni crédits) | multi
CREDITS_ENABLED=false      # multi uniquement : grand livre interne, aucun paiement
CREDITS_SIGNUP=100         # crédits offerts à l'inscription
REGISTRATION_OPEN=true
ADMIN_EMAIL=               # multi : compte administrateur créé au démarrage
ADMIN_PASSWORD=

# --- Génération ---
GENERATION_BACKEND=mock    # mock | comfyui | runpod | fal
GPU_PROFILE=vram24         # vram12 (GGUF Q4) | vram16 (FP8) | vram24 (FP8)
COMFYUI_URL=http://127.0.0.1:8188
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
FAL_KEY=
CACHE_ENABLED=true

# --- Garde-fous ---
SAFETY_URL=                # optionnel : POST {url}/classify → {"nsfw":0..1}
SAFETY_THRESHOLD=0.7

# --- Divers ---
PORT=8080
MAX_UPLOAD_MB=50
MOCK_DELAY_MS=350
WORKER_MODE=embedded       # embedded | external (lancer `node apps/api/src/server.ts --worker-only` à part)
SECURE_COOKIES=false       # true derrière HTTPS
MODELS_DIR=./models        # dossier des poids pour le service comfyui
